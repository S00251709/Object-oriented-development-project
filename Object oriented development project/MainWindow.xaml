<Window x:Class="Object_oriented_development_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Object_oriented_development_project"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="PlayerHealthText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" FontSize="16"/>
        <TextBlock x:Name="PlayerScoreText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" FontSize="16"/>
        <TextBlock x:Name="InventoryText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,70,0,0" FontSize="16"/>

        <TextBlock x:Name="RoomDescriptionText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,120,0,0" Width="550" FontSize="14" TextWrapping="Wrap"/>

        <TextBlock x:Name="CombatText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,250,0,0" Width="550" FontSize="14" TextWrapping="Wrap"/>

        <Button Content="Choose Room" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="40" Margin="10,200,0,0" Click="ChooseRoomButton_Click"/>
    </Grid>
</Window>
